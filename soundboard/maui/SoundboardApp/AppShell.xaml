<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="SoundboardApp.AppShell"
       Shell.NavBarIsVisible="False"
       Shell.BackgroundColor="{StaticResource Chassis}"
       Shell.TabBarBackgroundColor="{StaticResource Chassis}"
       Shell.TabBarForegroundColor="{StaticResource Ink}"
       Shell.TabBarTitleColor="{StaticResource Ink}"
       Shell.TabBarUnselectedColor="{StaticResource Muted}">
    <TabBar x:Name="Tabs">
        <Tab Title="Tablero" Icon="tab_board.png" Route="board" x:Name="BoardTab" />
        <Tab Title="Configurar" Icon="tab_config.png" Route="config" x:Name="ConfigTab" />
    </TabBar>
</Shell>

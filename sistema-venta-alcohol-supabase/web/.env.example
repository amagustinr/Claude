# Copie este archivo como .env.local y complete con los datos de su proyecto Supabase
# (Supabase > Project Settings > API). Estas dos llaves son públicas: van al navegador.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Dominio ficticio para convertir "usuario" en el correo que exige Supabase Auth
# (admin -> admin@botilleria.local). No se envían correos a esta dirección.
VITE_DOMINIO_USUARIOS=botilleria.local
